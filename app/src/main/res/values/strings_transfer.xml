<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 평행파일: PC ↔ 휴대폰 파일 전송 -->
    <string name="transfer_title">평행파일</string>
    <string name="transfer_back">뒤로</string>

    <string name="transfer_url_label">PC 브라우저 주소창에 입력하세요</string>
    <string name="transfer_pin_label">접속 PIN</string>
    <string name="transfer_steps">1. PC와 휴대폰을 같은 Wi-Fi에 연결하세요.\n2. PC의 Chrome이나 Edge에서 위 주소를 여세요.\n3. 브라우저에 PIN을 입력하세요. PC에는 아무것도 설치하지 않아도 됩니다.</string>
    <string name="transfer_keep_open_title">이 화면을 열어 두세요</string>
    <string name="transfer_keep_open_body">이 화면을 나가거나 10분 동안 전송이 없으면 연결이 끊어집니다. 이 화면이 열려 있는 동안에는 화면이 꺼지지 않습니다.</string>
    <string name="transfer_starting">연결을 준비하는 중입니다…</string>

    <string name="transfer_no_wifi_title">Wi-Fi에 연결되어 있지 않습니다</string>
    <string name="transfer_no_wifi_body">휴대폰을 PC와 같은 Wi-Fi에 연결한 뒤 다시 시도하세요. PC를 휴대폰 핫스팟에 연결해도 됩니다.</string>
    <string name="transfer_no_port_title">연결을 열지 못했습니다</string>
    <string name="transfer_no_port_body">사용할 수 있는 포트(8080~8090)가 없습니다. 잠시 후 다시 시도하세요.</string>
    <string name="transfer_timed_out_title">연결이 끊어졌습니다</string>
    <string name="transfer_timed_out_body">10분 동안 전송이 없어 보안을 위해 연결을 닫았습니다. 다시 시작하면 PIN이 바뀌므로 PC에서 다시 입력하세요.</string>
    <string name="transfer_retry">다시 시도</string>
    <string name="transfer_restart">다시 시작</string>

    <string name="transfer_section_send">PC로 보내기</string>
    <string name="transfer_send_body">고른 파일이 PC 브라우저의 목록에 나타납니다. PC에서 눌러 내려받으세요.</string>
    <string name="transfer_pick_files">파일 선택</string>
    <string name="transfer_picker_unavailable">파일 선택 화면을 열 수 없습니다</string>
    <string name="transfer_no_shared">아직 고른 파일이 없습니다.</string>
    <string name="transfer_remove">빼기</string>

    <string name="transfer_section_received">PC에서 받은 파일</string>
    <string name="transfer_saved_to">저장 위치: %1$s</string>
    <string name="transfer_no_received">PC 브라우저에서 파일을 끌어다 놓으면 여기에 표시됩니다.</string>
    <string name="transfer_size_unknown">크기 알 수 없음</string>
</resources>
